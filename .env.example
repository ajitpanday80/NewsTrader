# Alpha Vantage API Configuration
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Signal TTL Configuration (in minutes)
SIGNAL_TTL_MINUTES=30

# Cleanup Job Configuration (how often to check for expired signals, in minutes)
CLEANUP_INTERVAL_MINUTES=5

# News Fetch Configuration (how often to fetch new news, in minutes)
NEWS_FETCH_INTERVAL_MINUTES=5

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
